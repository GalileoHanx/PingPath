/target
**/*.rs.bk
.DS_Store
.idea/
.vscode/
*.swp

# Raw logs are not redacted and never go in the repository. Reviewed
# diagnostic reports (.md) in logs/ do; see logs/README.md.
*.log
/logs/*
!/logs/*.md

# Terraform working state, and variable files that may hold secrets.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
