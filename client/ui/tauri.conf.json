{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PingPath",
  "mainBinaryName": "PingPath",
  "identifier": "net.pingpath.client",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PingPath",
        "width": 1000,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PingPath",
    "copyright": "The PingPath contributors. MIT OR Apache-2.0.",
    "license": "MIT OR Apache-2.0",
    "category": "Utility",
    "shortDescription": "Lower, steadier ping for online games",
    "longDescription": "PingPath carries a game's traffic through relays near the game's servers when that is measurably faster than your direct route, and falls back to the direct route by itself if anything fails.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pingpath-service.exe": "pingpath-service.exe",
      "resources/wintun.dll": "wintun.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
